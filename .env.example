# Copy to .env, never commit the actual .env
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_API_KEY=replace-with-your-key
OPENAI_MODEL=your-chat-model
# Optional. Defaults to 0. A zero value disables the temperature field.
# OPENAI_TEMPERATURE=0.7
# Optional. Number of seconds allowed for each provider call.
AI_TIMEOUT_SECONDS=45
